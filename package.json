{
  "name": "lumo-userscript-manager",
  "description": "A powerful, well-crafted userscript manager for your browser",
  "private": true,
  "version": "1.0.4",
  "license": "MIT",
  "author": "mscststs",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mscststs/lumo-userscript-manager.git"
  },
  "homepage": "https://github.com/mscststs/lumo-userscript-manager#readme",
  "bugs": {
    "url": "https://github.com/mscststs/lumo-userscript-manager/issues"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "predev": "npm run build:runtime",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "npm run build:runtime",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "prezip": "npm run build:runtime",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "wxt prepare",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "i18n:manifest": "node scripts/i18n/manifest.mjs",
    "i18n:scan": "node scripts/i18n/scan-hardcoded.mjs",
    "i18n:context": "node scripts/i18n/context.mjs",
    "lint": "eslint ."
  },
  "overrides": {
    "@vitejs/plugin-react": "^5.0.4"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.11",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
